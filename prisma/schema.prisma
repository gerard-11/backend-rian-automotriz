generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BudgetStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum WorkOrderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ItemType {
  SERVICE
  LABOR
  PART
  TIRE
  OTHER
}

model AdminUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles   Vehicle[]
  budgets    Budget[]
  workOrders WorkOrder[]

  @@index([name])
  @@index([phone])
}

model Vehicle {
  id         String   @id @default(uuid())
  customerId String
  plate      String?
  make       String?
  model      String?
  year       Int?
  color      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  budgets    Budget[]
  workOrders WorkOrder[]

  @@index([customerId])
  @@index([plate])
  @@index([make, model])
}

model Budget {
  id                    String       @id @default(uuid())
  folio                 Int          @unique @default(autoincrement())
  customerId            String
  vehicleId             String
  status                BudgetStatus @default(PENDING)
  diagnosis             String?
  notes                 String?
  totalSaleAmount       Decimal      @default(0) @db.Decimal(10, 2)
  totalCostAmount       Decimal      @default(0) @db.Decimal(10, 2)
  estimatedProfitAmount Decimal      @default(0) @db.Decimal(10, 2)
  validUntil            DateTime?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  convertedAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  items      BudgetItem[]
  workOrder  WorkOrder?

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
}

model BudgetItem {
  id          String   @id @default(uuid())
  budgetId    String
  type        ItemType
  description String
  saleAmount  Decimal  @db.Decimal(10, 2)
  costAmount  Decimal? @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([type])
}

model WorkOrder {
  id                String          @id @default(uuid())
  folio             Int             @unique @default(autoincrement())
  customerId        String
  vehicleId         String
  budgetId          String?         @unique
  status            WorkOrderStatus @default(ACTIVE)
  diagnosis         String?
  notes             String?
  advanceAmount     Decimal         @default(0) @db.Decimal(10, 2)
  totalSaleAmount   Decimal         @default(0) @db.Decimal(10, 2)
  totalCostAmount   Decimal         @default(0) @db.Decimal(10, 2)
  grossProfitAmount Decimal         @default(0) @db.Decimal(10, 2)
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle  Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  budget   Budget?         @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  items    WorkOrderItem[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([completedAt])
  @@index([createdAt])
}

model WorkOrderItem {
  id          String   @id @default(uuid())
  workOrderId String
  type        ItemType
  description String
  saleAmount  Decimal  @db.Decimal(10, 2)
  costAmount  Decimal? @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([type])
}

model ExpenseCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
}

model Expense {
  id          String   @id @default(uuid())
  categoryId  String?
  description String
  amount      Decimal  @db.Decimal(10, 2)
  spentAt     DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([spentAt])
}
