NODE_ENV=production
PORT=3000

# Railway/Render Postgres connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Must be at least 32 characters.
JWT_SECRET=change-this-to-a-long-random-secret-32

# Frontend URL allowed by CORS. Do not include a trailing slash.
CORS_ORIGIN=https://your-frontend-domain.com

# Initial admin user created on container startup when it does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin

# Optional startup flags.
RUN_MIGRATIONS=true
RUN_ADMIN_SEED=true
